# COBBS INTELLIGENCE — Environment Example
# Copy to .env and fill values. Never commit real secrets.

# Application
APP_NAME=COBBS Intelligence
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://cobbs:cobbs@localhost:5432/cobbs
DATABASE_URL_SYNC=postgresql://cobbs:cobbs@localhost:5432/cobbs

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Providers (FREE_FIRST by default)
AI_MODE=FREE_FIRST
# xAI / Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Gemini
GOOGLE_API_KEY=
# Groq
GROQ_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Token / spend budgets (PREMIUM mode)
AI_TOKEN_BUDGET_DAILY=100000
AI_SPEND_BUDGET_DAILY_USD=10.00

# Security
MAX_TOOL_CALLS_PER_REQUEST=20
REQUEST_TIMEOUT_SECONDS=60
WORKER_CONCURRENCY=4

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cobbs-intelligence
